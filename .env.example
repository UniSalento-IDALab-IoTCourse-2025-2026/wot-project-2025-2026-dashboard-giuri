# Copia questo file in .env.local e valorizzalo per il tuo ambiente.
# .env.local NON va committato (già in .gitignore).

# URL del backend FastAPI (REST)
VITE_API_URL=https://localhost:8443

# URL del broker Mosquitto via WebSocket (TLS)
VITE_BROKER_URL=wss://localhost:9002

# Percorsi ASSOLUTI ai certificati mkcert già usati da Mosquitto/FastAPI.
# Se lasciati vuoti, il dev server Vite parte in HTTP semplice.
VITE_TLS_CERT=/percorso/assoluto/a/mosquitto/certs/server.crt
VITE_TLS_KEY=/percorso/assoluto/a/mosquitto/certs/server.key
